  - m_Id: 382746929065998
    m_Localized: "\uAD00\uCE21\uC744 \uC2DC\uC791\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065997
    m_Localized: "\uADDC\uCE59 \uC704\uBC18\uC774 \uAC10\uC9C0\uB420 \uACBD\uC6B0\n<b>\"\uD328\uB110\uD2F0\"</b>
      \uAC00 \uC9D1\uD589\uB420 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065996
    m_Localized: "\uD604\uC7AC \uC601\uC5ED\uC5D0\uB294 \uB2E8\uC77C \uADDC\uCE59\uB9CC
      \uC801\uC6A9\uC911\uC774\uB2E4.\n[\uCDA9\uB3CC\uC5D0 \uB300\uD55C \uD68C\uD53C]"
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065995
    m_Localized: "\uAC00\uC7A5 \uADFC\uC811\uD55C \uADDC\uCE59 \uC9D1\uD589 \uAC1C\uCCB4\uAC00\n\uD574\uB2F9
      \uC88C\uD45C\uB85C \uC7AC\uC9C0\uC815\uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065994
    m_Localized: "[\uACBD\uACE0] \uC608\uC678 \uD56D\uBAA9\uC744 \uD5A5\uD55C \uADDC\uCE59
      \uC751\uB2F5\uC774 \uBC1C\uC0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065993
    m_Localized: ......
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065992
    m_Localized: "\uC124\uACC4 \uC678 \uC0C1\uD0DC\uB85C \uC778\uD55C \uD310\uB2E8\uC744
      \uBCF4\uB958.\n\uC784\uC2DC \uBCF4\uD638 \uD504\uB85C\uD1A0\uCF5C\uC744 \uC801\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065991
    m_Localized: "\uAD00\uCE21 \uACB0\uACFC, \uD558\uB098\uB294 \uADDC\uCE59\uC5D0
      \uC644\uC804\uD788 \uC885\uC18D\uB418\uC5B4 \uC788\uC73C\uBA70, \uB2E4\uB978
      \uD558\uB098\uB294 \uC5B4\uB5A0\uD55C \uADDC\uCE59\uC5D0\uB3C4 \uD3EC\uD568\uB418\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065990
    m_Localized: "\uC608\uC678 \uD56D\uBAA9 \uC2DD\uBCC4\uC790: \"FAIL-ORDER-UNORDER\""
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065989
    m_Localized: "\uC774 \uC0C1\uD0DC\uB97C \uC720\uC9C0\uD558\uB294 \uD3B8\uC774
      \uC2DC\uC2A4\uD15C \uC548\uC815\uC131\uC5D0 \uC720\uB9AC\uD55C \uAC83\uC73C\uB85C
      \uACC4\uC0B0\uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065988
    m_Localized: "<Shake=3\uAC70\uBD80\uB428.</Shake>"
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065987
    m_Localized: ......
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065986
    m_Localized: "\uC0AD\uC81C \uC694\uCCAD."
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065985
    m_Localized: "\uC774 \uADDC\uCE59 \uC138\uD2B8\uB294 \uB450 \uAC1C\uC758 \uAD00\uCE21
      \uC8FC\uCCB4\uB97C \uC804\uC81C\uB85C \uD558\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 382746929065984
    m_Localized: "\uCC98\uB9AC \uBD88\uAC00 \uC0C1\uD0DC \uBC1C\uC0DD"
